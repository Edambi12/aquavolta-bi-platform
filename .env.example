# AQUAVOLTA BI Platform - environment template (placeholders only).
# Copy to `.env` (git-ignored) and fill in your own values. Never commit real values.

# --- Frontend (copy the VITE_* lines to app/.env) ---------------------------
VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"

# --- Analytics notebooks ----------------------------------------------------
# Folder holding the confidential Excel workbooks (not in the repository)
AQUAVOLTA_DATA_DIR="./data/raw"
# Folder receiving the cleaned workbooks produced by the notebooks
AQUAVOLTA_OUTPUT_DIR="./data/processed"

# --- Local MySQL / MariaDB (Talend + Power BI connect to these) -------------
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="your-mysql-user"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_STAGING_DB="datasa"
MYSQL_WAREHOUSE_DB="data_war_house"
